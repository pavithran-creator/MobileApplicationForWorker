# ============================================================
# ON-DEMAND Labour Cooperative Marketplace — Environment Config
# Target Architecture: Vercel (Next.js) + Supabase (PostgreSQL, Auth, Storage, Realtime)
# ============================================================

# Supabase Project Credentials (from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-server-only

# API Gateway URL (Defaults to relative /api for unified Next.js + Vercel deployment)
NEXT_PUBLIC_API_URL=/api

# Optional: Google Gemini AI API Key (Server-side entity extraction & demand intelligence)
AI_API_KEY=
